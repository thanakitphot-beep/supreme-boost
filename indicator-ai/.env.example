INDICATOR_ENV=development
INDICATOR_RAG_BACKEND=memory
INDICATOR_DATABASE_URL=postgresql+asyncpg://indicator:indicator@postgres:5432/indicator
INDICATOR_REDIS_URL=redis://redis:6379/0
INDICATOR_QDRANT_URL=http://qdrant:6333
INDICATOR_QDRANT_COLLECTION=indicator_knowledge
INDICATOR_EMBEDDING_DIMENSIONS=1024
# Local demo memory: tenant + browser-conversation scoped, retained 30 days.
INDICATOR_CONVERSATION_STORE_PATH=data/conversations.json
INDICATOR_CONVERSATION_TTL_HOURS=720
# Leave blank to keep the safe deterministic answer mode during development.
INDICATOR_MODEL_BASE_URL=
INDICATOR_MODEL_NAME=
INDICATOR_MODEL_API_KEY=
# Required whenever the service is enabled. Match the Node backend value.
INDICATOR_SERVICE_TOKEN=
