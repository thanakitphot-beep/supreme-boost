# Environment variables for Supreme Boost

# Gemini/Google Generative Language API key (Primary)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Groq API Key (Fallback 1)
GROQ_API_KEY=YOUR_GROQ_API_KEY

# Cohere API Key (Fallback 2)
COHERE_API_KEY=YOUR_COHERE_API_KEY

# Optional: override the Gemini model
GEMINI_MODEL=gemini-2.5-flash

# ==========================================
# OMEGA-JARVIS v3.0.0 Configuration
# ==========================================

# Database
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_KEY=YOUR_SUPABASE_KEY

# Security & Auth
JWT_SECRET=your-super-secure-256-bit-secret-key
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d
ADMIN_PASSWORD=your-secure-admin-password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_BURST=10

# Redis Cache (Optional for serverless, recommended for K8s)
REDIS_URL=redis://localhost:6379

# Feature Flags
ENABLE_VOICE=false
ENABLE_PLUGINS=true
ENABLE_VISION=true
ENABLE_MULTI_AGENT=true
ENABLE_AUTO_HEAL=false
