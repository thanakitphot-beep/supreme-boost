# Environment variables for Supreme Boost

# Gemini/Google Generative Language API key (Primary)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# OpenAI API Key
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Groq API Key
GROQ_API_KEY=YOUR_GROQ_API_KEY

# ==========================================
# INDICATOR AI Architecture Variables
# ==========================================
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq

AI_FAST_MODEL=gemini-1.5-flash
AI_NORMAL_MODEL=gemini-2.5-flash
AI_REASONING_MODEL=gemini-2.5-pro
AI_FALLBACK_MODEL=llama-3.3-70b-versatile

AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
AI_CIRCUIT_MAX_FAILURES=3

# Local AI Support
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=

# ==========================================
# OMEGA-JARVIS v3.0.0 Configuration
# ==========================================

# Database
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_KEY=YOUR_SUPABASE_KEY

# Security & Auth
JWT_SECRET=your-super-secure-256-bit-secret-key
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d
ADMIN_PASSWORD=your-secure-admin-password

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_BURST=10

# Redis Cache (Optional for serverless, recommended for K8s)
REDIS_URL=redis://localhost:6379

# Feature Flags
ENABLE_VOICE=false
ENABLE_PLUGINS=true
ENABLE_VISION=true
ENABLE_MULTI_AGENT=true
ENABLE_AUTO_HEAL=false

# SMTP Email for OTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="INDICATOR WEB CHAT <your_email@gmail.com>"
