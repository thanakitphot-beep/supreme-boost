# Environment variables for Supreme Boost

# Gemini/Google Generative Language API key (Primary)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Optional query synthesis adds provider cost and latency to knowledge imports.
KNOWLEDGE_SYNTHESIS_ENABLED=false

# OpenAI API Key
OPENAI_API_KEY=YOUR_OPENAI_API_KEY

# Groq API Key
GROQ_API_KEY=YOUR_GROQ_API_KEY

# ==========================================
# INDICATOR AI Architecture Variables
# ==========================================
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq

OPENAI_MODEL=gpt-5.6-terra
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
# Legacy provider defaults retained for existing deployments.
AI_NORMAL_MODEL=gemini-2.5-flash
AI_FALLBACK_MODEL=llama-3.3-70b-versatile

AI_REQUEST_TIMEOUT_MS=15000
AI_TOTAL_TIMEOUT_MS=22000
AI_MAX_RETRIES=2
AI_CIRCUIT_MAX_FAILURES=3

# Local AI Support
LOCAL_AI_BASE_URL=
LOCAL_AI_MODEL=

# ==========================================
# OMEGA-JARVIS v3.0.0 Configuration
# ==========================================

# Database
SUPABASE_URL=YOUR_SUPABASE_URL
SUPABASE_KEY=YOUR_SUPABASE_KEY
MONGODB_URI=
MONGODB_DB_NAME=indicator_db
MONGODB_MAX_POOL_SIZE=5
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_PING_TIMEOUT_MS=2000

# Security & Auth
JWT_SECRET=
JWT_EXPIRY=24h
JWT_REFRESH_EXPIRY=7d
ADMIN_PASSWORD=
RATE_LIMIT_SECRET=
ENABLE_LEGACY_HMAC_AUTH=false
# Keep false in serverless/ephemeral deployments. Enable only with a persistent disk.
INDICATOR_FILE_LEARNING=false
REQUIRE_TENANT_API_KEY=true
# Enforce a selected local site profile's exact allowedOrigins. This is always
# enforced in production whenever a data-site-key resolves to a profile.
INDICATOR_STRICT_SITE_ORIGIN=true
# Allow an explicit local demo without a tenant key. Keep false in production.
INDICATOR_ALLOW_FIRST_PARTY_DEMO=false
GOOGLE_CLIENT_ID=

# Optional internal Python intelligence service. It remains disabled unless all
# three values are configured, and the service must not be exposed publicly.
INDICATOR_INTELLIGENCE_MODE=off
INDICATOR_INTELLIGENCE_URL=
INDICATOR_INTELLIGENCE_SERVICE_TOKEN=

# Browser origins allowed to call the API in production (comma-separated)
ENFORCE_STRICT_CORS=true
CORS_ALLOWED_ORIGINS=https://your-site.example
PUBLIC_BASE_URL=https://api.your-site.example

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_CHAT_MAX=30
RATE_LIMIT_BURST=10
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_ADMIN_MAX=30
RATE_LIMIT_BILLING_MAX=20
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_HOPS=1

# Redis Cache (Optional for serverless, recommended for K8s)
REDIS_URL=redis://localhost:6379

# Feature Flags
ENABLE_VOICE=false
ENABLE_PLUGINS=true
ENABLE_VISION=true
ENABLE_MULTI_AGENT=true
ENABLE_AUTO_HEAL=false

# Safe Free Preview defaults. Enable SMTP only after an end-to-end delivery test.
REGISTRATION_MODE=disabled
HANDOFF_DELIVERY_MODE=contact_only
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Manual mode requires admin approval. Enable providers only after sandbox tests.
PAYMENT_MODE=manual
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_SUCCESS_URL=https://api.your-site.example/dashboard?checkout=success
STRIPE_CANCEL_URL=https://api.your-site.example/pricing?checkout=cancelled
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=
# Digits used to match the receiver account returned by SlipOK.
SLIPOK_RECEIVER_ACCOUNT=
SLIPOK_MAX_AGE_SECONDS=86400
